# ---------------------------------------------------------------
# Copy this file to .env.local (or .env.staging) and fill in
# values for your environment. Never commit the real files.
# ---------------------------------------------------------------

# Django core
DJANGO_ENV=local
DJANGO_SECRET_KEY=replace-with-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# Database
DB_NAME=three_hundred_club
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# CORS / CSRF (comma-separated URLs, no trailing slash)
# Local example: http://localhost:4200
# Staging:       https://staging.300clubleaderboard.com
# Production:    https://300clubleaderboard.com
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200
