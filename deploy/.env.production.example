# ---------------------------------------------------------------
# Production environment variables for /opt/leaderboard/.env.production
# Copy this file to /opt/leaderboard/.env.production on the server,
# fill in the real values, and chmod 600.
# NEVER commit the real file.
# ---------------------------------------------------------------

DJANGO_ENV=production
DJANGO_SECRET_KEY=replace-with-a-real-50-char-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS="300clubleaderboard.com www.300clubleaderboard.com"

DB_NAME=three_hundred_club
DB_USER=leaderboard
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=db
DB_PORT=5432

# Comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=https://300clubleaderboard.com
CSRF_TRUSTED_ORIGINS=https://300clubleaderboard.com,https://www.300clubleaderboard.com
